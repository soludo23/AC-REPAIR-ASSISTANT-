# =========================================================
# INPUT MODE ENGINE
# =========================================================

def get_cause(text, mode):
    text = text.lower()

    base = {
        "communication": "Communication failure between indoor and outdoor unit",
        "sensor": "Faulty or disconnected thermistor sensor",
        "compressor": "Compressor overload or winding failure",
        "pressure": "Refrigerant pressure imbalance",
        "fan": "Fan motor or capacitor failure",
        "voltage": "Power supply instability",
        "freeze": "Airflow restriction or refrigerant issue"
    }

    for k in base:
        if k in text:
            return base[k]

    return "General system malfunction (" + mode + " system)"

def get_solutions():
    return [
        "Check wiring and connectors",
        "Test sensors with multimeter",
        "Inspect PCB for burn damage",
        "Check compressor winding resistance",
        "Verify voltage supply stability",
        "Clean condenser and evaporator",
        "Check refrigerant pressure",
        "Replace faulty component if needed"
    ]

# =========================================================
# DIAGNOSTIC ENGINE
# =========================================================

def diagnose(brand, code, mode):

    brand = brand.upper()
    code = code.upper()
    mode = mode.upper()

    if brand not in BRAND_DATABASE:
        print("\n❌ Brand not found")
        return

    if code not in BRAND_DATABASE[brand]:
        print("\n❌ Error code not found")
        return

    fault = BRAND_DATABASE[brand][code]
    cause = get_cause(fault, mode)
    solutions = get_solutions()

    print("\n==============================")
    print(" AC DIAGNOSTIC REPORT")
    print("==============================")
    print("Time:", datetime.now())
    print("Brand:", brand)
    print("Mode:", mode)
    print("Error Code:", code)

    print("\nFAULT:")
    print(fault)

    print("\nCAUSE:")
    print(cause)

    print("\nSOLUTION:")

    for i, s in enumerate(solutions, 1):
        print(i, s)

    print("\n==============================")

